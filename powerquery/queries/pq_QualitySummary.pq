// pq_QualitySummary: підсумок якості по джерелах (структура й порядок - fn_SummaryTable).
// Звіти будуються тут же, без посилання на окремий запит (qc_Reports видалено у v4.12): межа між
// запитами коштувала 20-33% часу через окреме обчислення (профайлер 25.10.2026, запуски 7-13,
// варіанти поруч в одному запуску). Запит відкриває файли, тому сам читає книгу через fn_LoadConfig
// (правило трьох видів запитів).
let
    T = fn_SummaryTable(fn_QcReports(fn_LoadConfig()))
in
    T